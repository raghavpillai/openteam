{
  "name": "@openteam/ios",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "python3 scripts/generate-project.py && bun scripts/export-robot-artwork.ts && bun NotificationService/generate-notification-artwork.ts && bun scripts/export-message-renderer.ts && bun scripts/export-computer-vnc.ts",
    "native:check": "python3 scripts/check-native-config.py",
    "test": "python3 scripts/check-native-config.py && bun scripts/export-robot-artwork.ts --check",
    "test:core": "swift test -c release",
    "test:ui": "bash scripts/verify.sh",
    "performance": "swift test -c release --filter HistoryPerformanceTests"
  },
  "devDependencies": {
    "@openteam/contracts": "workspace:*",
    "@openteam/design-tokens": "workspace:*",
    "@novnc/novnc": "1.7.0",
    "dompurify": "3.4.14",
    "katex": "0.16.47",
    "marked": "18.0.5",
    "mermaid": "11.17.1"
  }
}
