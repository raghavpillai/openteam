{
  "$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.turbo",
      "!!**/.next",
      "!!**/.vinext",
      "!!**/.vercel",
      "!!**/.expo",
      "!!**/.wrangler",
      "!!**/dist",
      "!!**/dist-electron",
      "!!**/dist-web",
      "!!**/release",
      "!!**/release-local",
      "!!**/ios/Pods",
      "!!**/ios/build",
      "!!plans/evidence",
      "!!packages/db/src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
