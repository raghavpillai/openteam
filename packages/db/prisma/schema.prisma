generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ComputerStatus {
  starting
  ready
  unavailable
  degraded
}

enum BotStatus {
  provisioning
  active
  archived
  failed
}

enum OnboardingStatus {
  pending
  queued
  running
  completed
  failed
  skipped_by_user
}

enum ConversationContinuity {
  empty
  attached
  detached
}

enum MessageRole {
  user
  assistant
  system
}

enum MessageStatus {
  queued
  streaming
  completed
  failed
}

enum ChannelKind {
  bot_dm
  agent_dm
  group
}

enum ChannelMessageSender {
  user
  agent
  system
}

enum ChannelRoundStatus {
  queued
  running
  completed
  failed
}

enum ChannelDeliveryStatus {
  pending
  queued
  processing
  completed
  failed
  skipped
}

enum RunOrigin {
  user
  agent
  group
  bootstrap
  routine
  event
  background_revival
  handoff_resume
  broadcast
}

enum RoutineScheduleKind {
  cron
  interval
  event
}

enum RoutineExecutionKind {
  scheduled
  test
}

enum RoutineExecutionStatus {
  queued
  running
  waiting_approval
  completed
  failed
  cancelled
  skipped
}

enum RunStatus {
  queued
  running
  waiting_approval
  completed
  failed
  cancelled
  interrupted
}

enum InboxStatus {
  pending
  processing
  completed
  failed
}

enum InboxDeliveryMode {
  turn
  steer
}

enum OutboxStatus {
  pending
  delivering
  delivered
  failed
}

enum PushDevicePlatform {
  ios
  android
}

enum RunItemKind {
  agent_message
  reasoning
  command
  file_change
  tool
  compaction
  error
}

enum RunItemStatus {
  pending
  running
  waiting_approval
  completed
  failed
  cancelled
}

enum ApprovalKind {
  command
  file_change
  permissions
  user_input
}

enum ApprovalStatus {
  pending
  accepted
  declined
  cancelled
  expired
}

enum IdempotencyStatus {
  processing
  completed
  failed
}

enum MemoryScope {
  agent
  user
  project
}

enum MemoryTier {
  profile
  log
  note
}

enum TodoStatus {
  pending
  in_progress
  completed
  cancelled
}

enum SubagentStatus {
  provisioning
  queued
  running
  completed
  failed
  stopped
}

enum PluginInstallStatus {
  installed
  disabled
  error
}

enum PluginConnectionStatus {
  disconnected
  needs_auth
  ready
  error
  revoked
}

enum PluginToolDecision {
  deny
  prompt
  allow
}

enum PluginInvocationStatus {
  running
  completed
  failed
  denied
}

model Computer {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @default("OpenBot computer")
  status       ComputerStatus @default(starting)
  capabilities Json           @default("{}")
  lastSeenAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Bot {
  id               String       @id @default(uuid()) @db.Uuid
  name             String
  title            String       @default("")
  description      String       @default("")
  instructions     String       @default("")
  icon             String       @default("●")
  color            String       @default("#4f7cff")
  namedBy          String       @default("user")
  notificationsEnabled Boolean  @default(true)
  hiddenFromSidebar Boolean     @default(false)
  dreamingEnabled     Boolean     @default(false)
  episodePending      Int         @default(0)
  episodeTurns        Json        @default("[]")
  avatarPath       String?
  defaultDirectory String
  status           BotStatus    @default(provisioning)
  onboardingStatus OnboardingStatus @default(pending)
  onboardingVersion Int         @default(1)
  onboardingCompletedAt DateTime?
  provisioningError Json?
  runtimeProvider   String       @default("pi")
  runtimeSessionId  String?      @unique
  runtimeSessionPath String?     @unique
  conversation     Conversation?
  messages         Message[]
  runs             Run[]
  inboxEvents      InboxEvent[]
  lease            BotRunLease?
  channelMemberships ChannelMember[]
  sentChannelMessages ChannelMessage[] @relation("ChannelMessageSenderBot")
  initiatedRounds  ChannelRound[]      @relation("ChannelRoundInitiator")
  channelDeliveries ChannelDelivery[]
  writtenMemoryFacts MemoryFact[]      @relation("MemoryFactWriter")
  savedSkills      SavedSkill[]
  routines         Routine[]
  promptSnapshot   AgentPromptSnapshot?
  fileStates       AgentFileState[]
  projectMemberships ProjectMember[]
  createdProjects  Project[]           @relation("ProjectCreator")
  connectorStates  BotConnectorState[]
  todos            TodoItem[]
  parentSubagents  Subagent[]           @relation("ParentSubagents")
  subagentIdentity Subagent?            @relation("ChildSubagent")
  pluginEnablements BotPluginEnablement[]
  pluginConnectionGrants BotPluginConnectionGrant[]
  pluginToolPolicies PluginToolPolicy[]
  pluginActivities PluginActivity[]
  pluginInvocations PluginInvocation[]
  contextSessions ContextSession[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status, updatedAt])
}

model TodoItem {
  botId      String     @db.Uuid
  bot        Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
  id         String
  content    String
  status     TodoStatus
  position   Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@id([botId, id])
  @@unique([botId, position])
  @@index([botId, status, position])
}

model Subagent {
  id               String         @id @default(uuid()) @db.Uuid
  parentBotId      String         @db.Uuid
  parentBot        Bot            @relation("ParentSubagents", fields: [parentBotId], references: [id], onDelete: Cascade)
  childBotId       String         @unique @db.Uuid
  childBot         Bot            @relation("ChildSubagent", fields: [childBotId], references: [id], onDelete: Cascade)
  parentRunId      String         @db.Uuid
  parentChannelId  String         @db.Uuid
  currentRunId     String?        @unique @db.Uuid
  launchCallId     String
  description      String
  prompt           String
  subagentType     String
  model            String?
  fileAttachments  Json           @default("[]")
  runInBackground  Boolean        @default(true)
  status           SubagentStatus @default(provisioning)
  result           String?
  error            Json?
  outputPath       String
  startedAt        DateTime?
  completedAt      DateTime?
  stoppedAt        DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  attempts         SubagentAttempt[]

  @@unique([parentBotId, launchCallId])
  @@index([parentBotId, status, createdAt])
  @@index([childBotId, status])
}

model SubagentAttempt {
  id                String         @id @default(uuid()) @db.Uuid
  subagentId        String         @db.Uuid
  subagent          Subagent       @relation(fields: [subagentId], references: [id], onDelete: Cascade)
  parentRunId       String         @db.Uuid
  parentChannelId   String         @db.Uuid
  parentToolCallId  String
  childRunId        String?        @unique @db.Uuid
  description       String
  prompt            String
  fileAttachments   Json           @default("[]")
  runInBackground   Boolean        @default(true)
  status            SubagentStatus @default(provisioning)
  result            String?
  error             Json?
  startedAt         DateTime?
  completedAt       DateTime?
  stoppedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([subagentId, parentToolCallId])
  @@index([parentChannelId, createdAt])
  @@index([subagentId, status, createdAt])
}

model MemoryFact {
  id             String      @id @default(uuid()) @db.Uuid
  namespace      String
  scope          MemoryScope
  tier           MemoryTier  @default(log)
  projectSlug    String?
  fact           String
  factHash       String
  logicalId      String      @default("")
  sourcePath     String      @default("")
  sourceOrdinal  Int         @default(0)
  sourceLine     Int         @default(0)
  importance     Float       @default(1)
  origin         String      @default("legacy")
  writtenByBotId String?      @db.Uuid
  writtenByBot   Bot?         @relation("MemoryFactWriter", fields: [writtenByBotId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([namespace, sourcePath, sourceOrdinal])
  @@index([namespace, logicalId, createdAt])
  @@index([namespace, tier, updatedAt])
  @@index([writtenByBotId, updatedAt])
}

model SavedSkill {
  id          String   @id @default(uuid()) @db.Uuid
  botId       String?  @db.Uuid
  bot         Bot?     @relation(fields: [botId], references: [id], onDelete: SetNull)
  slug        String   @unique
  name        String
  description String
  body        String
  frontmatter Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([updatedAt])
}

model Routine {
  id              String              @id @default(uuid()) @db.Uuid
  botId           String?             @db.Uuid
  bot             Bot?                @relation(fields: [botId], references: [id], onDelete: Cascade)
  channelId       String?             @db.Uuid
  channel         Channel?            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  prompt          String
  trigger         Json                @default("{}")
  triggerPresentation Json?
  provenance      String              @default("untrusted")
  scheduleText    String
  scheduleKind    RoutineScheduleKind
  cronExpression  String?
  intervalSeconds Int?
  timezoneMode    String              @default("installation")
  timezone        String
  enabled         Boolean             @default(true)
  revision        Int                 @default(1)
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  pausedAt        DateTime?
  deletedAt       DateTime?
  pendingNotices  Json                @default("[]")
  raisedNotices   Json                @default("[]")
  runLedger       Json                @default("[]")
  revisions       RoutineRevision[]
  executions      RoutineExecution[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([enabled, nextRunAt])
  @@index([botId, deletedAt, updatedAt])
  @@index([channelId, deletedAt, updatedAt])
  @@unique([botId, slug])
  @@unique([channelId, slug])
}

model RoutineRevision {
  id              String              @id @default(uuid()) @db.Uuid
  routineId       String              @db.Uuid
  routine         Routine             @relation(fields: [routineId], references: [id], onDelete: Cascade)
  revision        Int
  name            String
  prompt          String
  scheduleText    String
  scheduleKind    RoutineScheduleKind
  cronExpression  String?
  intervalSeconds Int?
  timezoneMode    String
  timezone        String
  enabled         Boolean
  source          String
  callId          String?
  runId           String?             @db.Uuid
  executions      RoutineExecution[]
  createdAt       DateTime            @default(now())

  @@unique([routineId, revision])
}

model RoutineExecution {
  id                String                 @id @default(uuid()) @db.Uuid
  routineId         String                 @db.Uuid
  routine           Routine                @relation(fields: [routineId], references: [id], onDelete: Cascade)
  routineRevisionId String                 @db.Uuid
  routineRevision   RoutineRevision        @relation(fields: [routineRevisionId], references: [id], onDelete: Restrict)
  runId             String?                @unique @db.Uuid
  run               Run?                   @relation(fields: [runId], references: [id], onDelete: SetNull)
  channelMessageId  String?                @unique @db.Uuid
  channelMessage    ChannelMessage?        @relation("RoutineTriggerMessage", fields: [channelMessageId], references: [id], onDelete: SetNull)
  kind              RoutineExecutionKind
  status            RoutineExecutionStatus @default(queued)
  dedupeKey         String                 @unique
  scheduledFor      DateTime
  enqueuedAt        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  skipReason        String?
  error             Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([routineId, createdAt])
  @@index([status, createdAt])
}

model Project {
  slug           String          @id
  name           String
  description    String          @default("")
  workingDirectory String
  createdByBotId String?         @db.Uuid
  createdByBot   Bot?            @relation("ProjectCreator", fields: [createdByBotId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ProjectMember {
  projectSlug String   
  project     Project  @relation(fields: [projectSlug], references: [slug], onDelete: Cascade)
  botId       String   @db.Uuid
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  joinedAt    DateTime @default(now())

  @@id([projectSlug, botId])
  @@index([botId, joinedAt])
}

model BotConnectorState {
  botId        String   @db.Uuid
  bot          Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  platform     String
  connected    Boolean  @default(true)
  disconnectedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([botId, platform])
  @@index([platform, connected])
}

model Channel {
  id          String           @id @default(uuid()) @db.Uuid
  kind        ChannelKind
  name        String
  description String           @default("")
  avatarPath  String?
  directKey   String?          @unique
  workingDirectory String?
  archivedAt  DateTime?
  members     ChannelMember[]
  messages    ChannelMessage[]
  rounds      ChannelRound[]
  runs        Run[]
  routines    Routine[]
  readState   ChannelReadState?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([kind, updatedAt])
}

model ChannelReadState {
  channelId        String   @id @db.Uuid
  channel          Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  lastReadSequence BigInt   @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ChannelMember {
  channelId String   @db.Uuid
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  botId     String   @db.Uuid
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  ordinal   Int
  createdAt DateTime @default(now())

  @@id([channelId, botId])
  @@unique([channelId, ordinal])
  @@index([botId, channelId])
}

model ChannelMessage {
  id             String               @id @default(uuid()) @db.Uuid
  sequence       BigInt               @default(autoincrement())
  channelId      String               @db.Uuid
  channel        Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender         ChannelMessageSender
  senderBotId    String?              @db.Uuid
  senderBot      Bot?                 @relation("ChannelMessageSenderBot", fields: [senderBotId], references: [id], onDelete: SetNull)
  sourceRunId    String?              @db.Uuid
  sourceRun      Run?                 @relation("VisibleRunMessage", fields: [sourceRunId], references: [id], onDelete: SetNull)
  clientId       String?
  content        String               @default("")
  metadata       Json                 @default("{}")
  triggeredRound ChannelRound?        @relation("RoundTrigger")
  routineExecution RoutineExecution?  @relation("RoutineTriggerMessage")
  createdAt      DateTime             @default(now())

  @@unique([channelId, clientId])
  @@index([channelId, sequence])
  @@index([senderBotId, createdAt])
}

model ChannelRound {
  id             String             @id @default(uuid()) @db.Uuid
  channelId      String             @db.Uuid
  channel        Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  triggerMessageId String           @unique @db.Uuid
  triggerMessage ChannelMessage     @relation("RoundTrigger", fields: [triggerMessageId], references: [id], onDelete: Cascade)
  rootMessageId  String             @db.Uuid
  roundIndex     Int                @default(0)
  memberTurnOffset Int              @default(0)
  initiatorBotId String?            @db.Uuid
  initiatorBot   Bot?               @relation("ChannelRoundInitiator", fields: [initiatorBotId], references: [id], onDelete: SetNull)
  status         ChannelRoundStatus @default(queued)
  currentOrdinal Int                @default(-1)
  deliveries     ChannelDelivery[]
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([channelId, status, createdAt])
  @@index([rootMessageId, roundIndex])
}

model ChannelDelivery {
  id          String                @id @default(uuid()) @db.Uuid
  roundId     String                @db.Uuid
  round       ChannelRound          @relation(fields: [roundId], references: [id], onDelete: Cascade)
  botId       String                @db.Uuid
  bot         Bot                   @relation(fields: [botId], references: [id], onDelete: Cascade)
  ordinal     Int
  status      ChannelDeliveryStatus @default(pending)
  run         Run?
  startedAt   DateTime?
  completedAt DateTime?
  error       Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([roundId, botId])
  @@unique([roundId, ordinal])
  @@index([botId, status, createdAt])
}

model Conversation {
  id             String                 @id @default(uuid()) @db.Uuid
  botId          String                 @unique @db.Uuid
  bot            Bot                    @relation(fields: [botId], references: [id], onDelete: Cascade)
  codexThreadId  String?                @unique
  codexSessionId String?
  continuity     ConversationContinuity @default(empty)
  compactionEpoch Int                   @default(0)
  messages       Message[]
  runs           Run[]
  inboxEvents    InboxEvent[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model ContextSession {
  id                 String              @id @default(uuid()) @db.Uuid
  botId              String              @db.Uuid
  bot                Bot                 @relation(fields: [botId], references: [id], onDelete: Cascade)
  scope              String
  scopeId            String              @db.Uuid
  runtimeSessionId   String?             @unique
  runtimeSessionPath String?             @unique
  compactionEpoch    Int                 @default(0)
  lastArchiveId      String?             @db.Uuid
  compactions        ContextCompaction[]
  promptSnapshot     ContextPromptSnapshot?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([botId, scope, scopeId])
  @@index([botId, scope])
}

model ContextCompaction {
  id               String         @id @db.Uuid
  contextSessionId String         @db.Uuid
  contextSession   ContextSession @relation(fields: [contextSessionId], references: [id], onDelete: Cascade)
  sequence         Int
  reason           String
  prefixDigest     String
  summaryDigest    String
  status           String         @default("adopted")
  tokensBefore     Int?
  tokensAfter      Int?
  imageCount       Int            @default(0)
  turnCount        Int            @default(0)
  startedAt        DateTime
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([contextSessionId, sequence])
  @@index([contextSessionId, status])
}

model ContextPromptSnapshot {
  contextSessionId      String         @id @db.Uuid
  contextSession        ContextSession @relation(fields: [contextSessionId], references: [id], onDelete: Cascade)
  profileEpoch          Int            @default(-1)
  profileSection        String         @default("")
  systemName            String         @default("")
  systemDescription     String         @default("")
  announcedName         String         @default("")
  announcedDescription  String         @default("")
  memoryEpoch           Int            @default(-1)
  memoryRender          String         @default("")
  memoryHasFacts        Boolean        @default(false)
  skillEpoch            Int            @default(-1)
  skillRender           String         @default("")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model AgentPromptSnapshot {
  botId                 String   @id @db.Uuid
  bot                   Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  profileEpoch          Int      @default(-1)
  profileSection        String   @default("")
  systemName            String   @default("")
  systemDescription     String   @default("")
  announcedName         String   @default("")
  announcedDescription  String   @default("")
  memoryEpoch           Int      @default(-1)
  memoryRender          String   @default("")
  memoryHasFacts        Boolean  @default(false)
  skillEpoch            Int      @default(-1)
  skillRender           String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model AgentFileState {
  path          String   @id
  botId         String?  @db.Uuid
  bot           Bot?     @relation(fields: [botId], references: [id], onDelete: Cascade)
  kind          String
  digest        String?
  validDigest   String?
  exists        Boolean  @default(true)
  error         String?
  generation    Int      @default(0)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([botId, kind])
  @@index([kind, lastSeenAt])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  botId          String        @db.Uuid
  bot            Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversationId String        @db.Uuid
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId          String?       @db.Uuid
  run            Run?          @relation("RunMessages", fields: [runId], references: [id], onDelete: SetNull)
  clientId       String?
  upstreamItemId String?
  role           MessageRole
  content        String        @default("")
  status         MessageStatus @default(queued)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([conversationId, clientId])
  @@unique([conversationId, upstreamItemId])
  @@index([conversationId, createdAt])
}

model Run {
  id             String       @id @default(uuid()) @db.Uuid
  botId          String       @db.Uuid
  bot            Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userMessageId  String       @unique @db.Uuid
  status         RunStatus    @default(queued)
  runtimeTurnId  String?
  origin         RunOrigin    @default(user)
  channelId      String?      @db.Uuid
  channel        Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  deliveryId     String?      @unique @db.Uuid
  delivery       ChannelDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  error          Json?
  startedAt      DateTime?
  completedAt    DateTime?
  messages       Message[]    @relation("RunMessages")
  visibleMessages ChannelMessage[] @relation("VisibleRunMessage")
  items          RunItem[]
  approvals      Approval[]
  inboxEvents    InboxEvent[]
  lease          BotRunLease?
  routineExecution RoutineExecution?
  pluginInvocations PluginInvocation[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([botId, status])
  @@index([conversationId, createdAt])
  @@index([channelId, createdAt])
}

model InboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  botId          String       @db.Uuid
  bot            Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  runId          String       @db.Uuid
  run            Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  idempotencyKey String       @unique
  type           String       
  payload        Json
  deliveryMode   InboxDeliveryMode @default(turn)
  status         InboxStatus  @default(pending)
  priority       Int          @default(0)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now())
  claimedAt      DateTime?
  completedAt    DateTime?
  error          Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([botId, status, priority, availableAt, createdAt])
  @@index([botId, deliveryMode, status])
}

model BotRunLease {
  botId      String   @id @db.Uuid
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  runId      String   @unique @db.Uuid
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  ownerId    String
  expiresAt  DateTime
  heartbeatAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model OutboxDelivery {
  id          String       @id @default(uuid()) @db.Uuid
  deliveryKey String       @unique
  topic       String
  target      String
  payload     Json
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  deliveredAt DateTime?
  error       Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, availableAt])
}

model PushDevice {
  id             String             @id @default(uuid()) @db.Uuid
  installationId String             @unique
  platform       PushDevicePlatform
  pushToken      String             @unique
  enabled        Boolean            @default(true)
  timeZone       String?
  locale         String?
  lastSeenAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([enabled, platform, lastSeenAt])
}

model RunItem {
  id             String        @id @default(uuid()) @db.Uuid
  runId          String        @db.Uuid
  run            Run           @relation(fields: [runId], references: [id], onDelete: Cascade)
  upstreamItemId String?
  kind           RunItemKind
  status         RunItemStatus @default(pending)
  title          String?
  content        Json          @default("{}")
  startedAt      DateTime?
  completedAt    DateTime?
  approvals      Approval[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([runId, upstreamItemId])
  @@index([runId, createdAt])
}

model Approval {
  id                String         @id @default(uuid()) @db.Uuid
  runId             String         @db.Uuid
  run               Run            @relation(fields: [runId], references: [id], onDelete: Cascade)
  runItemId         String?        @db.Uuid
  runItem           RunItem?       @relation(fields: [runItemId], references: [id], onDelete: SetNull)
  upstreamRequestId String         @unique
  requestMethod     String
  kind              ApprovalKind
  status            ApprovalStatus @default(pending)
  details           Json
  decision          String?
  resolvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([runId, status])
}

model Event {
  sequence      BigInt   @id @default(autoincrement())
  topic         String
  entityId      String?  @db.Uuid
  schemaVersion Int      @default(1)
  payload       Json
  createdAt     DateTime @default(now())

  @@index([topic, sequence])
}

model IdempotencyRecord {
  scope       String
  key         String
  requestHash String
  response    Json?
  status      IdempotencyStatus @default(processing)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@id([scope, key])
  @@index([expiresAt])
}

model PluginInstallation {
  id          String              @id @default(uuid()) @db.Uuid
  pluginKey   String              @unique
  version     String
  name        String
  description String              @default("")
  publisher   String
  manifest    Json
  status      PluginInstallStatus @default(installed)
  installedAt DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  connections PluginConnection[]
  enablements BotPluginEnablement[]
  activities  PluginActivity[]

  @@index([status, updatedAt])
}

model PluginConnection {
  id            String                 @id @default(uuid()) @db.Uuid
  installationId String                @db.Uuid
  installation  PluginInstallation     @relation(fields: [installationId], references: [id], onDelete: Cascade)
  connectorKey  String
  name          String
  alias         String                 @default("default")
  transport     String
  authType      String
  endpoint      String?
  status        PluginConnectionStatus @default(disconnected)
  statusMessage String?
  instructions  String                 @default("")
  configuration Json                   @default("{}")
  credentials   Json                   @default("{}")
  toolSnapshot  Json                   @default("[]")
  connectedAt   DateTime?
  lastCheckedAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  grants        BotPluginConnectionGrant[]
  policies      PluginToolPolicy[]
  activities    PluginActivity[]
  invocations   PluginInvocation[]

  @@unique([installationId, connectorKey, alias])
  @@index([status, updatedAt])
}

model BotPluginEnablement {
  botId          String             @db.Uuid
  bot            Bot                @relation(fields: [botId], references: [id], onDelete: Cascade)
  installationId String             @db.Uuid
  installation   PluginInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  enabled        Boolean            @default(true)
  skillsEnabled  Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@id([botId, installationId])
  @@index([installationId, enabled])
}

model BotPluginConnectionGrant {
  botId       String           @db.Uuid
  bot         Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  connectionId String          @db.Uuid
  connection  PluginConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  enabled     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@id([botId, connectionId])
  @@index([connectionId, enabled])
}

model PluginToolPolicy {
  id           String             @id @default(uuid()) @db.Uuid
  connectionId String             @db.Uuid
  connection   PluginConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  botId        String?            @db.Uuid
  bot          Bot?               @relation(fields: [botId], references: [id], onDelete: Cascade)
  toolName     String
  decision     PluginToolDecision
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([connectionId, botId, toolName])
  @@index([botId, connectionId])
}

model PluginActivity {
  id             String              @id @default(uuid()) @db.Uuid
  installationId String?             @db.Uuid
  installation   PluginInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  connectionId   String?             @db.Uuid
  connection     PluginConnection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  botId          String?             @db.Uuid
  bot            Bot?                @relation(fields: [botId], references: [id], onDelete: SetNull)
  kind           String
  summary        String
  metadata       Json                @default("{}")
  createdAt      DateTime            @default(now())

  @@index([createdAt])
  @@index([connectionId, createdAt])
  @@index([botId, createdAt])
}

model PluginInvocation {
  id           String                 @id @default(uuid()) @db.Uuid
  callId       String                 @unique
  connectionId String                 @db.Uuid
  connection   PluginConnection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  botId        String                 @db.Uuid
  bot          Bot                    @relation(fields: [botId], references: [id], onDelete: Cascade)
  runId        String?                @db.Uuid
  run          Run?                   @relation(fields: [runId], references: [id], onDelete: SetNull)
  toolName     String
  decision     PluginToolDecision
  status       PluginInvocationStatus @default(running)
  arguments    Json                   @default("{}")
  result       Json?
  error        String?
  startedAt    DateTime               @default(now())
  completedAt  DateTime?

  @@index([botId, startedAt])
  @@index([connectionId, startedAt])
  @@index([runId, startedAt])
}

// Better Auth owns these four tables. OpenBot deliberately provisions only
// one credential account through the server CLI command.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  username      String?   @unique
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
