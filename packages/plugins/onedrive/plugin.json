{
  "key": "onedrive",
  "version": "1.0.0",
  "name": "OneDrive",
  "description": "Find files and folders, and transfer files directly between OneDrive and the bot box.",
  "publisher": "OpenTeam",
  "category": "Documents & Files",
  "featured": true,
  "components": [
    "mcp"
  ],
  "homepageUrl": "https://learn.microsoft.com/en-us/graph/onedrive-concept-overview",
  "setup": {
    "kind": "oauth_client",
    "connectionKey": "onedrive",
    "title": "Connect OneDrive",
    "description": "Configure a Microsoft Entra OAuth application for personal or work accounts, then sign in.",
    "documentationUrl": "https://learn.microsoft.com/en-us/graph/auth-register-app-v2",
    "steps": [
      "Register a Microsoft Entra application with the supported account types you need.",
      "Add the exact OpenTeam callback URL as a Web redirect URI.",
      "Add delegated Files.ReadWrite, User.Read and offline_access permissions. Save the client ID and secret, then sign in."
    ],
    "fields": [
      {
        "key": "clientId",
        "label": "OAuth client ID",
        "placeholder": "Paste the client ID",
        "required": true,
        "secret": false,
        "helpText": null
      },
      {
        "key": "clientSecret",
        "label": "OAuth client secret",
        "placeholder": "Paste the client secret",
        "required": true,
        "secret": true,
        "helpText": "Stored by your self-hosted OpenTeam server and never returned to the desktop app."
      }
    ],
    "requiredScopes": [
      "offline_access",
      "User.Read",
      "Files.ReadWrite"
    ],
    "dashboardUrl": "https://entra.microsoft.com/"
  },
  "skills": [],
  "connections": [
    {
      "key": "onedrive",
      "name": "OneDrive",
      "transport": "stdio",
      "auth": "oauth",
      "endpoint": "",
      "tools": [],
      "oauth": {
        "clientType": "confidential",
        "registration": "manual",
        "tokenEndpointAuthMethod": "client_secret_post",
        "shareClientCredentials": true,
        "authorizationServer": {
          "issuer": "https://login.microsoftonline.com/common/v2.0",
          "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
          "tokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token"
        },
        "accessTokenEnv": "MICROSOFT_ACCESS_TOKEN"
      },
      "configuration": {
        "oauthAuthorizationParameters": {
          "prompt": "select_account"
        },
        "command": "bun",
        "args": [
          "${PLUGIN_ROOT}/connector/server.mjs"
        ]
      }
    }
  ],
  "schemaVersion": 1,
  "icon": "assets/icon.png"
}
