{
  "name": "openbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/client-core",
    "packages/contracts",
    "packages/db",
    "packages/design-tokens",
    "packages/messaging",
    "packages/product-core"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "bun run typecheck && bun run test && bun run build && bun scripts/performance/check-desktop-budgets.ts",
    "check:architecture": "bun scripts/check-workspace-boundaries.ts && bun scripts/check-contract-enum-parity.ts && bun scripts/check-mobile-bundle-boundary.ts && bun scripts/check-client-source-duplication.ts",
    "test:cli:e2e": "bun scripts/test-cli-e2e.ts",
    "test:auth:e2e": "bun scripts/test-auth-e2e.ts",
    "db:generate": "bun --filter @openbot/db db:generate",
    "db:migrate": "bun --filter @openbot/db db:migrate",
    "db:deploy": "bun --filter @openbot/db db:deploy",
    "db:studio": "bun --filter @openbot/db db:studio",
    "auth:setup": "bun scripts/setup-dev-auth.ts",
    "compose:up": "bash scripts/compose.sh up --build",
    "compose:down": "bash scripts/compose.sh down",
    "desktop": "bun --filter @openbot/desktop dev",
    "desktop:performance": "bun --filter @openbot/desktop build && bun scripts/performance/check-desktop-budgets.ts",
    "desktop:performance:release": "bun --filter @openbot/desktop package",
    "desktop:tailscale": "bash scripts/tailscale-dev.sh",
    "mobile:performance": "bun --filter @openbot/mobile performance",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/bun": "1.3.8",
    "turbo": "2.10.11",
    "typescript": "5.9.3"
  },
  "patchedDependencies": {
    "@earendil-works/pi-coding-agent@0.84.3": "patches/@earendil-works%2Fpi-coding-agent@0.84.3.patch"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "deepmerge-ts": "8.0.1",
    "esbuild": "0.28.1",
    "mysql2": "3.24.2",
    "pg": "8.23.0",
    "postcss": "8.5.26",
    "uuid": "14.0.2",
    "ws": "8.21.3"
  }
}
