DATABASE_URL=postgresql://openbot:openbot@127.0.0.1:5432/openbot
OPENBOT_PORT=8787
OPENBOT_SERVER_URL=http://127.0.0.1:8787
OPENBOT_COMPUTER_URL=http://127.0.0.1:8790
OPENBOT_COMPUTER_PORT=8790
OPENBOT_CONTROL_TOKEN=replace-with-a-random-local-token
OPENBOT_AUTH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
OPENBOT_PROXY_SECRET=replace-with-another-random-secret-of-at-least-32-characters
# "required" uses the owner username/password session for every product API client.
# WARNING: "disabled" removes product API authentication; use it only on a fully trusted network.
OPENBOT_AUTH_MODE=required
OPENBOT_WORKSPACE_ROOT=/workspace
OPENBOT_AGENT_DATA_ROOT=/home/box/agent-data
OPENBOT_ASSET_ROOT=/asset-store
OPENBOT_TIME_ZONE=UTC
OPENBOT_ACCESS_MODE=local
OPENBOT_BIND_HOST=127.0.0.1
OPENBOT_VIEWER_BIND_HOST=127.0.0.1
OPENBOT_PUBLIC_HOST=127.0.0.1
OPENBOT_PUBLIC_URL=http://127.0.0.1:8787
OPENBOT_AUTH_URL=http://127.0.0.1:8787
COMPOSE_PROFILES=direct
OPENBOT_PI_AGENT_DIR=/home/box/.pi/agent
# Bootstrap defaults only; durable runtime selection lives in agent-data/settings.json.
OPENBOT_PI_PROVIDER=openai-codex
OPENBOT_PI_MODEL=gpt-5.5
OPENBOT_PI_THINKING=high
# Host-lifetime memory experiment gate. Grok defaults this off; it is not a per-Bot setting.
OPENBOT_MEMORY_DREAMING=false
# Optional absolute path inside the server container to an OpenBot marketplace v1 JSON manifest.
OPENBOT_MARKETPLACE_FILE=
OPENBOT_SUBAGENT_PER_PARENT_LIMIT=4
OPENBOT_SUBAGENT_GLOBAL_LIMIT=8
OPENBOT_WORKER_CONCURRENCY=8
# Optional enhanced-security token for the Expo Push Service.
EXPO_ACCESS_TOKEN=
# Mobile development/build values. The API must be reachable from the iPhone.
EXPO_PUBLIC_OPENBOT_API_URL=
EXPO_PUBLIC_EXPO_PROJECT_ID=
