{
  "name": "@openteam/server",
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun ../../packages/plugins/scripts/generate.ts && bun build src/main.ts --outdir dist --target bun --external pg-native --external @1password/sdk",
    "dev": "bun ../../packages/plugins/scripts/generate.ts && bun --watch src/main.ts",
    "start": "bun dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openteam/contracts": "workspace:*",
    "@openteam/db": "workspace:*",
    "@openteam/messaging": "workspace:*",
    "@openteam/plugin-sdk": "workspace:*",
    "@openteam/plugins": "workspace:*",
    "better-auth": "1.7.2",
    "effect": "3.22.1",
    "pg": "8.23.0",
    "pg-boss": "12.28.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.5"
  }
}
