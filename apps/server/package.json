{
  "name": "@openbot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target bun --external pg-native",
    "dev": "bun --watch src/main.ts",
    "start": "bun dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@openbot/contracts": "workspace:*",
    "@openbot/db": "workspace:*",
    "@openbot/messaging": "workspace:*",
    "effect": "3.22.1",
    "pg-boss": "12.28.0"
  }
}
