{
  "name": "@openbot/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "build": "EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform ios --output-dir dist",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:check": "bun ../../scripts/validation/check-mobile-native-config.ts",
    "performance": "bun ../../scripts/performance/check-mobile-budgets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --pass-with-no-tests && bun run native:check"
  },
  "dependencies": {
    "@openbot/client-core": "workspace:*",
    "@openbot/contracts": "workspace:*",
    "@openbot/design-tokens": "workspace:*",
    "@openbot/mobile-native": "file:./modules/openbot-native",
    "@openbot/product-core": "workspace:*",
    "expo": "57.0.18",
    "expo-clipboard": "57.0.1",
    "expo-constants": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "57.0.2",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.2",
    "dompurify": "3.3.3",
    "katex": "0.16.47",
    "marked": "16.3.0",
    "mermaid": "11.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "6.0.3"
  }
}
