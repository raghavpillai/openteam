DATABASE_URL=postgresql://openteam:openteam@127.0.0.1:5432/openteam
OPENTEAM_PORT=8787
OPENTEAM_SERVER_URL=http://127.0.0.1:8787
OPENTEAM_COMPUTER_URL=http://127.0.0.1:8790
OPENTEAM_COMPUTER_PORT=8790
OPENTEAM_CONTROL_TOKEN=replace-with-a-random-local-token
OPENTEAM_AUTH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
OPENTEAM_PROXY_SECRET=replace-with-another-random-secret-of-at-least-32-characters
# "required" uses the owner username/password session for every product API client.
# WARNING: "disabled" removes product API authentication; use it only on a fully trusted network.
OPENTEAM_AUTH_MODE=required
OPENTEAM_WORKSPACE_ROOT=/workspace
OPENTEAM_AGENT_DATA_ROOT=/home/box/agent-data
OPENTEAM_ASSET_ROOT=/asset-store
OPENTEAM_TIME_ZONE=UTC
OPENTEAM_ACCESS_MODE=local
OPENTEAM_BIND_HOST=127.0.0.1
OPENTEAM_VIEWER_BIND_HOST=127.0.0.1
OPENTEAM_PUBLIC_HOST=127.0.0.1
OPENTEAM_PUBLIC_URL=http://127.0.0.1:8787
OPENTEAM_AUTH_URL=http://127.0.0.1:8787
COMPOSE_PROFILES=direct
OPENTEAM_PI_AGENT_DIR=/home/box/.pi/agent
# Host-lifetime memory experiment gate. This defaults off; it is not a per-bot setting.
OPENTEAM_MEMORY_DREAMING=false
# Optional absolute path inside the server container to an OpenTeam marketplace v1 JSON manifest.
OPENTEAM_MARKETPLACE_FILE=
OPENTEAM_SUBAGENT_PER_PARENT_LIMIT=4
OPENTEAM_SUBAGENT_GLOBAL_LIMIT=8
OPENTEAM_WORKER_CONCURRENCY=8
# Optional enhanced-security token for the Expo Push Service.
EXPO_ACCESS_TOKEN=
# Mobile development/build values. The API must be reachable from the iPhone.
EXPO_PUBLIC_OPENTEAM_API_URL=
EXPO_PUBLIC_EXPO_PROJECT_ID=
