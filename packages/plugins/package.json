{
  "name": "@openteam/plugins",
  "version": "0.0.6",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun scripts/generate.ts && bun build src/index.ts --outdir dist --target bun",
    "typecheck": "bun run generate && tsc -p tsconfig.json",
    "test": "bun run generate && bun test --pass-with-no-tests",
    "upstream:check": "bun scripts/sync-upstream.ts --check",
    "upstream:sync": "bun scripts/sync-upstream.ts",
    "generate": "bun scripts/generate.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openteam/plugin-sdk": "workspace:*",
    "fflate": "0.8.3",
    "html-to-text": "9.0.5",
    "imapflow": "2.4.2",
    "nodemailer": "10.1.1",
    "postal-mime": "2.6.1",
    "xlsx": "file:../../vendor/sheetjs/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/html-to-text": "9.0.4",
    "@types/nodemailer": "8.0.2"
  }
}
