{
  "name": "@openteam/computer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts src/provider-cli.ts --outdir dist --target bun --external @earendil-works/pi-coding-agent --external playwright-core",
    "dev": "bun --watch src/main.ts",
    "start": "bun dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --pass-with-no-tests",
    "test:browser-workflows": "bun run scripts/test-browser-workflows.ts",
    "test:browser-reliability": "bun run scripts/test-browser-reliability.ts",
    "test:native-typing": "bun run scripts/test-native-typing.ts",
    "test:native-chooser": "bun run scripts/test-native-chooser.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@jimp/core": "1.6.0",
    "@jimp/js-bmp": "1.6.0",
    "@jimp/js-gif": "1.6.0",
    "@jimp/js-jpeg": "1.6.0",
    "@jimp/js-png": "1.6.0",
    "@jimp/js-tiff": "1.6.0",
    "@jimp/plugin-resize": "1.6.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@mozilla/readability": "0.6.0",
    "@openteam/contracts": "workspace:*",
    "@openteam/plugin-sdk": "workspace:*",
    "@openteam/shell-jobs": "workspace:*",
    "effect": "3.22.1",
    "ipaddr.js": "2.5.0",
    "linkedom": "0.18.13",
    "playwright-core": "1.55.0",
    "turndown": "7.2.4",
    "typebox": "1.3.7",
    "undici": "7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/turndown": "5.0.6"
  }
}
