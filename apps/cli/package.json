{
  "name": "@openteam/cli",
  "version": "0.0.1",
  "description": "Install and manage the self-hosted OpenTeam server stack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raghavpillai/openteam.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "openteam": "dist/openteam.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/main.ts --outfile dist/openteam.js --target=node --format=esm --minify",
    "build:release": "bun run scripts/build-release-binaries.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "test:doctor": "bun test ./test/doctor*.test.ts ./test/docker.test.ts",
    "test:install": "bun test ./test/preflight-command.test.ts ./test/setup-countdown.test.ts ./test/doctor-recovery.test.ts ./../landing/lib/install-script.test.ts",
    "test:install:fresh": "bun scripts/test-fresh-install.ts",
    "preview:doctor": "bun scripts/preview-doctor.ts",
    "test:status": "bun test ./test/status*.test.ts ./test/command-ui.test.ts ./test/lifecycle.test.ts",
    "preview:status": "bun scripts/preview-status.ts",
    "preview:model": "bun scripts/preview-model.ts",
    "test:model": "bun test ./test/model*.test.ts ./test/provider-connection*.test.ts ./test/detected-logins.test.ts"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "semver": "7.8.5",
    "sigstore": "5.0.0",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@openteam/product-core": "workspace:*",
    "@sigstore/bundle": "4.0.0",
    "@sigstore/protobuf-specs": "0.5.2",
    "@sigstore/verify": "3.1.1",
    "@tufjs/models": "4.1.0",
    "@types/semver": "7.7.1"
  }
}
